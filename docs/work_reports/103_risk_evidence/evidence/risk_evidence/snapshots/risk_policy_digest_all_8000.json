{
  "canonical_policy": {
    "$schema": "https://schema.hete.io/poa/v1.json",
    "data_constraints": {
      "canonical_encoding": "JCS",
      "input_schema": "protocol/schemas/transition-request.json",
      "maximum_message_bytes": 65536,
      "maximum_nesting_depth": 24
    },
    "failure_policy": {
      "internal_error": "abort",
      "invalid_request": "reject",
      "policy_violation": "reject",
      "quarantine_threshold": 3,
      "repeated_violation": "quarantine"
    },
    "mode": "production",
    "network_policy": {
      "dns_enabled": false,
      "inbound": [
        {
          "address": "127.0.0.1",
          "port": 7878,
          "protocol": "tcp"
        },
        {
          "address": "192.168.1.0/24",
          "port": 7878,
          "protocol": "tcp"
        }
      ],
      "outbound": []
    },
    "operations": [
      {
        "allowed_actors": [
          "ubuntu-ledger-gateway"
        ],
        "name": "verify_transition",
        "required_context": [
          "expiry",
          "policy_digest",
          "request_id"
        ]
      }
    ],
    "process_constraints": {
      "lock_after_initialization": true,
      "os_backend": "openbsd",
      "pledge_promises": [
        "inet",
        "rpath",
        "stdio",
        "wpath"
      ],
      "unveil_paths": [
        {
          "path": "/var/hete/audit",
          "permissions": "rw"
        },
        {
          "path": "/var/hete/policies",
          "permissions": "r"
        }
      ]
    },
    "protocol_id": "hete.verifier.payment",
    "risk_evidence": {
      "enabled": true,
      "minimum_confidence_bps": 8000,
      "minimum_occurrences": 3,
      "minimum_severity_bps": 8000,
      "threshold_mode": "all_thresholds"
    },
    "version": "1.0.0"
  },
  "git_commit": "dcf07a26308146a8766b9d8f07f0fc85a7d5b3a0",
  "policy_digest": "sha256:c929994c702cb1ff008faf297146583618389af51d26bf53b7d6250a59bd8289"
}
